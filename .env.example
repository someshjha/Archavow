# Copy to .env for local overrides (optional — compose.dev has defaults)

POSTGRES_DB=archavow
POSTGRES_USER=archavow
POSTGRES_PASSWORD=archavow

AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Set true so Compose can reach LAN/host Ollama; metadata URLs remain blocked.
ALLOW_PRIVATE_AI_URLS=true
# When set, all settings (and /me) require Authorization: Bearer <key>.
# ARCHAVOW_API_KEY=
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
